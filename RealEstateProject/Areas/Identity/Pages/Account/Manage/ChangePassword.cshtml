@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Security";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<!-- Change password -->
<section class="aqx-security-section">
    <h4 class="aqx-section-title">Change password</h4>
    <form id="change-password-form" method="post" class="aqx-manage-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>

        <div class="form-group mb-4">
            <label asp-for="Input.OldPassword" class="control-label block"></label>
            <input asp-for="Input.OldPassword" class="form-control w-full" autocomplete="current-password" placeholder="Current password" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Input.NewPassword" class="control-label block"></label>
            <input asp-for="Input.NewPassword" class="form-control w-full" autocomplete="new-password" placeholder="New password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Input.ConfirmPassword" class="control-label block"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control w-full" autocomplete="new-password" placeholder="Confirm new password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Password</button>
    </form>
</section>

<!-- Security overview -->
<section class="aqx-security-section">
    <h4 class="aqx-section-title">Security overview</h4>
    <div class="aqx-security-card">
        <div class="aqx-security-card-icon">
            <span class="material-symbols-outlined">history</span>
        </div>
        <div class="aqx-security-card-body">
            <p class="aqx-security-card-title">Last password change</p>
            @if (Model.LastPasswordChangeDate.HasValue)
            {
                <p class="aqx-security-card-meta">@Model.LastPasswordChangeDate.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
            }
            else
            {
                <p class="aqx-security-card-meta">Not recorded yet</p>
            }
        </div>
    </div>
</section>

<!-- Advanced security (prepared for the future) -->
<section class="aqx-security-section">
    <h4 class="aqx-section-title">Advanced security</h4>

    <div class="aqx-security-card aqx-security-card-muted">
        <div class="aqx-security-card-icon">
            <span class="material-symbols-outlined">encrypted</span>
        </div>
        <div class="aqx-security-card-body">
            <p class="aqx-security-card-title">Two-factor authentication</p>
            <p class="aqx-security-card-meta">Add an extra layer of security to your account.</p>
        </div>
        <button type="button" class="btn btn-secondary" disabled>Coming soon</button>
    </div>

    <div class="aqx-security-card aqx-security-card-muted">
        <div class="aqx-security-card-icon">
            <span class="material-symbols-outlined">devices</span>
        </div>
        <div class="aqx-security-card-body">
            <p class="aqx-security-card-title">Log out from all devices</p>
            <p class="aqx-security-card-meta">Sign out everywhere except this device.</p>
        </div>
        <button type="button" class="btn btn-secondary" disabled>Coming soon</button>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
