@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="aqx-page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>

<div class="aqx-detail-card">
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <p class="text-gray-400 mb-4">You are currently signed in.</p>
                <button type="submit" class="btn btn-primary">Click here to Logout</button>
            </form>
        }
        else
        {
            <p class="text-gray-400 m-0">You have successfully logged out of the application.</p>
        }
    }
</div>
