@model RealEstateProject.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isOwnerView = User.IsInRole("Owner") || User.IsInRole("Admin");
}

<header class="mb-8 flex justify-between items-end">
    <div>
        <h2 class="text-3xl font-bold text-white border-0 p-0 mb-1">Dashboard</h2>
        <p class="text-gray-400 mt-1">Welcome back. Here is your property overview.</p>
    </div>
    @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
    {
        <div class="hidden md:flex gap-4">
            <a asp-controller="Properties" asp-action="Create" class="bg-white text-black px-6 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition-opacity">Add Property</a>
        </div>
    }
</header>

<!-- Summary Grid Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="glass-panel p-6 rounded-xl flex items-center gap-4">
        <div class="bg-white/10 text-white p-3 rounded-lg">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">domain</span>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-400 mb-0">Total Properties</p>
            <p class="text-2xl font-bold text-white mb-0">@Model.TotalProperties</p>
        </div>
    </div>
    @if (isOwnerView)
    {
        <div class="glass-panel p-6 rounded-xl flex items-center gap-4">
            <div class="bg-gray-800 text-gray-300 p-3 rounded-lg">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">card_membership</span>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-400 mb-0">Active Subscriptions</p>
                <p class="text-2xl font-bold text-white mb-0">@Model.ActiveSubscriptions</p>
            </div>
        </div>
    }
    <div class="glass-panel p-6 rounded-xl flex items-center gap-4">
        <div class="bg-gray-800 text-gray-300 p-3 rounded-lg">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-400 mb-0">Average Rating</p>
            <p class="text-2xl font-bold text-white mb-0">@(Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("0.0") : "—")</p>
        </div>
    </div>
</div>

<!-- Main Layout Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Account Actions (Bento Style) -->
    <div class="lg:col-span-1 flex flex-col gap-6">
        <div class="glass-panel rounded-xl p-6">
            <h3 class="text-xl font-semibold text-white mb-1 border-0 p-0">My Account</h3>
            <p class="text-sm text-gray-400 mb-6">Manage your activity on AqarX</p>

            <div class="flex flex-col gap-2">
                @if (User.IsInRole("Owner"))
                {
                    <a asp-controller="Properties" asp-action="MyProperties" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">domain</span>
                        <div>
                            <h4 class="text-base font-semibold text-white m-0 p-0 border-0">My Properties</h4>
                            <p class="text-sm text-gray-400 m-0">View, edit and manage your listings</p>
                        </div>
                    </a>
                    <a asp-controller="Promotions" asp-action="Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">campaign</span>
                        <div>
                            <h4 class="text-base font-semibold text-white m-0 p-0 border-0">Promotions</h4>
                            <p class="text-sm text-gray-400 m-0">Promote your listed properties</p>
                        </div>
                    </a>
                    <a asp-controller="Subscriptions" asp-action="Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">credit_card</span>
                        <div>
                            <h4 class="text-base font-semibold text-white m-0 p-0 border-0">My Subscription</h4>
                            <p class="text-sm text-gray-400 m-0">View and manage your plan</p>
                        </div>
                    </a>
                }

                @if (User.IsInRole("Tenant"))
                {
                    <a asp-controller="Alerts" asp-action="Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">notifications_active</span>
                        <div>
                            <h4 class="text-base font-semibold text-white m-0 p-0 border-0">Alerts</h4>
                            <p class="text-sm text-gray-400 m-0">Manage saved search alerts</p>
                        </div>
                    </a>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">home_repair_service</span>
                        <div>
                            <h4 class="text-base font-semibold text-white m-0 p-0 border-0">Service Requests</h4>
                            <p class="text-sm text-gray-400 m-0">Track your moving & cleaning</p>
                        </div>
                    </a>
                }

                <!-- Shared for both -->
                <a asp-controller="Ratings" asp-action="Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1" style="font-variation-settings: 'FILL' 1;">star</span>
                    <div>
                        <h4 class="text-base font-semibold text-white m-0 p-0 border-0">Ratings</h4>
                        <p class="text-sm text-gray-400 m-0">View and give ratings</p>
                    </div>
                </a>
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="group flex items-start gap-4 p-3 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors mt-1">manage_accounts</span>
                    <div>
                        <h4 class="text-base font-semibold text-white m-0 p-0 border-0">Profile &amp; Settings</h4>
                        <p class="text-sm text-gray-400 m-0">Edit profile, email and security</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Properties -->
    <div class="lg:col-span-2 glass-panel rounded-xl p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-semibold text-white border-0 p-0 m-0">Recent Properties</h3>
            <a asp-controller="@(isOwnerView ? "Properties" : "Home")" asp-action="@(User.IsInRole("Owner") ? "MyProperties" : "Index")" class="text-sm text-gray-400 hover:text-white transition-colors">View All</a>
        </div>
        <div class="flex flex-col gap-4">
            @if (Model.RecentProperties.Any())
            {
                @foreach (var prop in Model.RecentProperties)
                {
                    var mediaUrl = prop.MediaFiles.Any()
                        ? prop.MediaFiles.First().MediaUrl
                        : "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=150&q=80";
                    var listing = prop.ListingStatus?.ToLower();
                    var statusColor = listing switch
                    {
                        "available" => "text-green-400",
                        "sold" => "text-red-400",
                        "rented" => "text-amber-400",
                        "reserved" => "text-gray-300",
                        _ => "text-gray-400"
                    };

                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@prop.PropId"
                       class="flex items-center justify-between p-4 bg-surface-container-high rounded-lg border border-white/5 hover:border-white/20 transition-colors">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded bg-cover bg-center" style="background-image: url('@mediaUrl')"></div>
                            <div>
                                <h4 class="text-base font-semibold text-white m-0 border-0 p-0">@prop.PropType</h4>
                                <p class="text-sm text-gray-400 m-0">@prop.Location</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-medium @statusColor m-0">@(string.IsNullOrEmpty(prop.ListingStatus) ? "—" : prop.ListingStatus)</p>
                            <p class="text-sm text-gray-400 m-0">@prop.Price?.ToString("N0") EGP</p>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="flex flex-col items-center justify-center text-center py-12">
                    <span class="material-symbols-outlined text-4xl text-gray-600 mb-2">domain_disabled</span>
                    <p class="text-gray-400 m-0">No properties to show yet.</p>
                </div>
            }
        </div>
    </div>
</div>