@model RealEstateProject.Models.Property

@{
    var status = Model.ListingStatus?.ToLower();
    string statusClasses = status switch
    {
        "available" => "bg-green-500/15 text-green-300 border border-green-500/25",
        "sold" => "bg-red-500/15 text-red-300 border border-red-500/25",
        "rented" => "bg-amber-500/15 text-amber-300 border border-amber-500/25",
        "reserved" => "bg-white/10 text-gray-200 border border-white/20",
        _ => "bg-white/10 text-gray-300 border border-white/15"
    };
    var mediaUrl = Model.MediaFiles.Any()
        ? Model.MediaFiles.First().MediaUrl
        : "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=600&q=80";
    // Edit/Delete تظهر للمالك بتاع العقار نفسه بس (أو الأدمن)
    var currentOwnerId = ViewBag.CurrentOwnerId as int?;
    var canManage = User.IsInRole("Admin")
        || (currentOwnerId != null && Model.OwnerId == currentOwnerId);
}

<div class="group flex flex-col bg-surface-container-low border border-white/5 rounded-2xl overflow-hidden hover:border-white/20 hover:-translate-y-1 transition-all duration-300 shadow-lg">
    <div class="relative h-48 bg-cover bg-center" style="background-image:url('@mediaUrl')">
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>
        <div class="relative z-10 flex items-start justify-between p-4">
            <span class="text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full backdrop-blur-md @statusClasses">@Model.ListingStatus</span>
            <span class="text-xs font-semibold text-white bg-black/40 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">@Model.PropType</span>
        </div>
    </div>

    <div class="flex flex-col flex-1 p-5">
        <div class="text-2xl font-bold text-white mb-1">
            @Model.Price?.ToString("N0") <span class="text-sm font-normal text-gray-400">EGP</span>
            @if (Model.Purpose == "Rent")
            {
                <span class="text-sm font-normal text-gray-500">/ month</span>
            }
        </div>

        <div class="flex items-center gap-1 text-sm text-gray-400 mb-4">
            <span class="material-symbols-outlined text-base">location_on</span>
            <span>@Model.Location</span>
        </div>

        <div class="flex items-center gap-2 text-xs text-gray-500 mb-4">
            <span>@Model.Purpose</span>
            <span>&bull;</span>
            <span>@Model.Conditions</span>
        </div>

        <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between">
            <span class="text-xs text-gray-400">
                by @(Model.Owner?.User?.Fname ?? "&mdash;") @(Model.Owner?.User?.Lname ?? "")
            </span>
            <div class="flex items-center gap-1">
                <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropId"
                   class="text-sm font-medium text-white hover:text-gray-300 px-3 py-1.5 rounded-lg hover:bg-surface-container-high transition-all">View</a>
                @if (canManage)
                {
                    <a asp-controller="Properties" asp-action="Edit" asp-route-id="@Model.PropId"
                       class="text-sm font-medium text-gray-400 hover:text-white px-3 py-1.5 rounded-lg hover:bg-surface-container-high transition-all">Edit</a>
                    <a asp-controller="Properties" asp-action="Delete" asp-route-id="@Model.PropId"
                       class="text-sm font-medium text-red-400 hover:text-red-300 px-3 py-1.5 rounded-lg hover:bg-red-500/10 transition-all">Delete</a>
                }
            </div>
        </div>
    </div>
</div>
