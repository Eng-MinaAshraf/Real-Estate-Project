@*
    Reusable page header.
    Usage:
      <partial name="_PageHeader" model='new RealEstateProject.Models.ViewModels.PageHeaderModel { Title = "Bookings", Subtitle = "3 bookings" }' />
    Or pass a title/subtitle via ViewData and render inline in the view.
*@
@model RealEstateProject.Models.ViewModels.PageHeaderModel

<div class="aqx-page-header">
    <div>
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="aqx-subtitle">@Model.Subtitle</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.ActionText) && !string.IsNullOrEmpty(Model.ActionUrl))
    {
        <a href="@Model.ActionUrl" class="btn btn-primary">@Model.ActionText</a>
    }
</div>
