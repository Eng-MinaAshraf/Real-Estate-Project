@model RealEstateProject.Models.Promotion

@{
    ViewData["Title"] = "Edit Promotion";
}

<div class="aqx-page-header">
    <div>
        <h1>Edit Promotion</h1>
        <p class="aqx-subtitle">Promotion #@Model.PromoId</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="PromoId" />

        <div class="form-group mb-4">
            <label asp-for="PropId" class="control-label block"></label>
            <select asp-for="PropId" class="form-control w-full" asp-items="ViewBag.PropId"></select>
            <span asp-validation-for="PropId" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="StartDate" class="control-label block"></label>
            <input asp-for="StartDate" class="form-control w-full" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="EndDate" class="control-label block"></label>
            <input asp-for="EndDate" class="form-control w-full" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="PaidAmount" class="control-label block"></label>
            <input asp-for="PaidAmount" class="form-control w-full" />
            <span asp-validation-for="PaidAmount" class="text-danger"></span>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
