@model RealEstateProject.Models.ServicePartner

@{
    ViewData["Title"] = "Edit Service Partner";
}

<div class="aqx-page-header">
    <div>
        <h1>Edit Service Partner</h1>
        <p class="aqx-subtitle">Partner #@Model.PartnerId</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="PartnerId" />

        <div class="form-group mb-4">
            <label asp-for="CompanyName" class="control-label block"></label>
            <input asp-for="CompanyName" class="form-control w-full" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="ServiceCategory" class="control-label block"></label>
            <input asp-for="ServiceCategory" class="form-control w-full" />
            <span asp-validation-for="ServiceCategory" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="CommissionRate" class="control-label block"></label>
            <input asp-for="CommissionRate" class="form-control w-full" />
            <span asp-validation-for="CommissionRate" class="text-danger"></span>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
