@model IEnumerable<RealEstateProject.Models.Rating>

@{
    ViewData["Title"] = "Ratings";
}

<div class="aqx-page-header">
    <div>
        <h1>Ratings</h1>
        <p class="aqx-subtitle">@Model.Count() rating(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <span class="material-symbols-outlined text-base">add</span> New Rating
    </a>
</div>

@if (Model.Any())
{
    <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="table w-full">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Giver)</th>
                    <th>@Html.DisplayNameFor(model => model.Receiver)</th>
                    <th>@Html.DisplayNameFor(model => model.Score)</th>
                    <th>@Html.DisplayNameFor(model => model.Comment)</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Giver.UserId)</td>
                        <td>@Html.DisplayFor(modelItem => item.Receiver.UserId)</td>
                        <td>@Html.DisplayFor(modelItem => item.Score)</td>
                        <td>@Html.DisplayFor(modelItem => item.Comment)</td>
                        <td>
                            <div class="aqx-actions justify-end">
                                <a asp-action="Details" asp-route-id="@item.RatingId" class="aqx-btn-ghost">View</a>
                                <a asp-action="Edit" asp-route-id="@item.RatingId" class="aqx-btn-ghost">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.RatingId" class="aqx-btn-ghost aqx-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="aqx-empty">
        <p>No ratings found.</p>
        <a asp-action="Create" class="btn btn-primary">New Rating</a>
    </div>
}
