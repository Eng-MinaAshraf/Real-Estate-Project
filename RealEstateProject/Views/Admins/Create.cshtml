@model RealEstateProject.Models.Admin

@{
    ViewData["Title"] = "New Admin";
}

<div class="aqx-page-header">
    <div>
        <h1>New Admin</h1>
        <p class="aqx-subtitle">Add an admin profile</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

        <div class="form-group mb-4">
            <label asp-for="AdminId" class="control-label block"></label>
            <select asp-for="AdminId" class="form-control w-full" asp-items="ViewBag.AdminId"></select>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
