@model List<RealEstateProject.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Count(n => !n.IsRead);
}

<div class="flex items-center justify-between mb-6 flex-wrap gap-4">
    <div>
        <h1 class="text-2xl font-bold text-white mb-1" style="border:none;">Notifications</h1>
        <p class="text-sm text-gray-400 m-0">
            @if (unread > 0)
            {
                <span>@unread unread</span>
            }
            else
            {
                <span>You're all caught up</span>
            }
        </p>
    </div>

    @if (unread > 0)
    {
        <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="aqx-notif-page-markall">
                <span class="material-symbols-outlined text-base">done_all</span>
                Mark all as read
            </button>
        </form>
    }
</div>

<div class="aqx-notif-page-list">
    @if (Model.Count == 0)
    {
        <div class="aqx-notif-page-empty">
            <span class="material-symbols-outlined">notifications_off</span>
            <p>No notifications yet</p>
        </div>
    }
    else
    {
        @foreach (var n in Model)
        {
            <a class="aqx-notif-page-item @(n.IsRead ? "" : "aqx-notif-unread")"
               href="@(string.IsNullOrEmpty(n.Url) ? "#" : n.Url)">
                <span class="aqx-notif-page-icon material-symbols-outlined">@(string.IsNullOrEmpty(n.Icon) ? "notifications" : n.Icon)</span>
                <span class="aqx-notif-page-body">
                    <span class="aqx-notif-page-item-title">@n.Title</span>
                    <span class="aqx-notif-page-item-msg">@n.Message</span>
                </span>
                <span class="aqx-notif-page-time">@n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                @if (!n.IsRead)
                {
                    <span class="aqx-notif-dot" aria-hidden="true"></span>
                }
            </a>
        }
    }
</div>
