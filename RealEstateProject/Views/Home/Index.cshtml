@model IEnumerable<RealEstateProject.Models.Property>

@{
    ViewData["Title"] = "Home";
    var currentType = ViewData["CurrentPropType"] as string;
    var currentPurpose = ViewData["CurrentPurpose"] as string;
}

<!-- Hero Section -->
<section class="text-center mb-12 pt-6">
    <h1 class="text-4xl md:text-5xl font-black text-white mb-3 leading-tight">
        Find your next place with AqarX
    </h1>
    <p class="text-gray-400 max-w-xl mx-auto">
        Browse verified properties for rent and sale, all in one place.
    </p>

    <!-- Search Bar -->
    <form asp-action="Index" method="get"
          class="mt-8 bg-surface-container-low p-4 rounded-2xl border border-white/10 shadow-xl max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-3 items-center">

        <div class="md:col-span-4 flex items-center gap-2 bg-surface-container-high rounded-xl px-3">
            <span class="material-symbols-outlined text-gray-500">search</span>
            <input type="text" name="location" value="@ViewData["CurrentLocation"]" placeholder="Location..."
                   class="flex-1 bg-transparent border-0 focus:ring-0 text-white placeholder-gray-500 py-3 text-sm" />
        </div>

        <select name="propType"
                class="md:col-span-2 bg-surface-container-high border-0 rounded-xl text-gray-300 focus:ring-1 focus:ring-white/30 text-sm py-3">
            <option value="" selected="@(string.IsNullOrEmpty(currentType))">All Types</option>
            <option value="Apartment" selected="@(currentType == "Apartment")">Apartment</option>
            <option value="Villa" selected="@(currentType == "Villa")">Villa</option>
            <option value="Studio" selected="@(currentType == "Studio")">Studio</option>
        </select>

        <select name="purpose"
                class="md:col-span-2 bg-surface-container-high border-0 rounded-xl text-gray-300 focus:ring-1 focus:ring-white/30 text-sm py-3">
            <option value="" selected="@(string.IsNullOrEmpty(currentPurpose))">Any Purpose</option>
            <option value="Sale" selected="@(currentPurpose == "Sale")">For Sale</option>
            <option value="Rent" selected="@(currentPurpose == "Rent")">For Rent</option>
        </select>

        <input type="number" name="maxPrice" value="@ViewData["CurrentMaxPrice"]" placeholder="Max Price"
               class="md:col-span-2 bg-surface-container-high border-0 rounded-xl text-white placeholder-gray-500 focus:ring-1 focus:ring-white/30 text-sm py-3 px-3" />

        <button type="submit"
                class="md:col-span-2 bg-white text-black px-6 py-3 rounded-xl font-semibold hover:bg-gray-200 transition-colors text-sm">
            Search
        </button>
    </form>
</section>

<!-- Section Header -->
<div class="flex items-end justify-between mb-6">
    <div>
        <h2 class="text-xl font-bold text-white mb-1">Available Properties</h2>
        <p class="text-sm text-gray-500">@Model.Count() properties found</p>
    </div>
    <a asp-controller="Properties" asp-action="Index"
       class="text-sm font-medium text-gray-400 hover:text-white flex items-center gap-1 transition-colors">
        View all <span class="material-symbols-outlined text-base">arrow_forward</span>
    </a>
</div>

<!-- Property Grid -->
@if (Model.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <partial name="_PropertyCard" model="item" />
        }
    </div>
}
else
{
    <div class="text-center py-20 bg-surface-container-low rounded-2xl border border-white/5">
        <span class="material-symbols-outlined text-5xl text-gray-600 mb-3">search_off</span>
        <p class="text-gray-400">No properties match your search.</p>
    </div>
}
