@model RealEstateProject.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="aqx-page-header">
    <div>
        <h1>Delete User</h1>
        <p class="aqx-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="aqx-detail-card">
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/25 text-red-300 text-sm">
        Are you sure you want to delete this user?
    </div>

    <dl class="row">
        <dt>@Html.DisplayNameFor(model => model.Fname)</dt>
        <dd>@Html.DisplayFor(model => model.Fname)</dd>
        <dt>@Html.DisplayNameFor(model => model.Lname)</dt>
        <dd>@Html.DisplayFor(model => model.Lname)</dd>
        <dt>@Html.DisplayNameFor(model => model.Email)</dt>
        <dd>@Html.DisplayFor(model => model.Email)</dd>
        <dt>@Html.DisplayNameFor(model => model.Password)</dt>
        <dd>@Html.DisplayFor(model => model.Password)</dd>
        <dt>@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd>@Html.DisplayFor(model => model.Phone)</dd>
        <dt>@Html.DisplayNameFor(model => model.Role)</dt>
        <dd>@Html.DisplayFor(model => model.Role)</dd>
    </dl>

    <form asp-action="Delete" class="aqx-actions-bar">
        <input type="hidden" asp-for="UserId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
