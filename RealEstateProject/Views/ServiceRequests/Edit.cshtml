@model RealEstateProject.Models.ServiceRequest

@{
    ViewData["Title"] = "Edit Service Request";
}

<div class="aqx-page-header">
    <div>
        <h1>Edit Service Request</h1>
        <p class="aqx-subtitle">Request #@Model.RequestId</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="RequestId" />

        <div class="form-group mb-4">
            <label asp-for="TenantId" class="control-label block"></label>
            <select asp-for="TenantId" class="form-control w-full" asp-items="ViewBag.TenantId"></select>
            <span asp-validation-for="TenantId" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="PartnerId" class="control-label block"></label>
            <select asp-for="PartnerId" class="form-control w-full" asp-items="ViewBag.PartnerId"></select>
            <span asp-validation-for="PartnerId" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="RequestDate" class="control-label block"></label>
            <input asp-for="RequestDate" class="form-control w-full" />
            <span asp-validation-for="RequestDate" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="Status" class="control-label block"></label>
            <input asp-for="Status" class="form-control w-full" />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
