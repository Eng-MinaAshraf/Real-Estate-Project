@model RealEstateProject.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="aqx-page-header">
    <div>
        <h1>Delete Service Request</h1>
        <p class="aqx-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="aqx-detail-card">
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/25 text-red-300 text-sm">
        Are you sure you want to delete this service request?
    </div>

    <dl class="row">
        <dt>@Html.DisplayNameFor(model => model.Tenant)</dt>
        <dd>@Html.DisplayFor(model => model.Tenant.TenantId)</dd>
        <dt>@Html.DisplayNameFor(model => model.ServicePartner)</dt>
        <dd>@Html.DisplayFor(model => model.ServicePartner.PartnerId)</dd>
        <dt>@Html.DisplayNameFor(model => model.RequestDate)</dt>
        <dd>@Html.DisplayFor(model => model.RequestDate)</dd>
        <dt>@Html.DisplayNameFor(model => model.Status)</dt>
        <dd>@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <form asp-action="Delete" class="aqx-actions-bar">
        <input type="hidden" asp-for="RequestId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
