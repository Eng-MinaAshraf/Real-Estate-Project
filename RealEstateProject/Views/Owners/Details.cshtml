@model RealEstateProject.Models.Owner

@{
    ViewData["Title"] = "Owner Details";
}

<div class="aqx-page-header">
    <div>
        <h1>Owner Details</h1>
        <p class="aqx-subtitle">Owner #@Model.OwnerId</p>
    </div>
</div>

<div class="aqx-detail-card">
    <dl class="row">
        <dt>@Html.DisplayNameFor(model => model.User)</dt>
        <dd>@Html.DisplayFor(model => model.User.UserId)</dd>
    </dl>

    <div class="aqx-actions-bar">
        <a asp-action="Edit" asp-route-id="@Model?.OwnerId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
