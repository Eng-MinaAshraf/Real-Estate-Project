@model IEnumerable<RealEstateProject.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-black text-white mb-1">My Properties</h1>
        <p class="text-sm text-gray-500">@Model.Count() properties listed by you</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-white text-black px-5 py-2.5 rounded-xl font-semibold hover:bg-gray-200 transition-colors text-sm self-start sm:self-auto">
        <span class="material-symbols-outlined text-base">add</span>
        New Property
    </a>
</div>

@if (Model.Any())
{
    <!-- Status overview table: Publish Status + Listing Status -->
    <div class="overflow-x-auto mb-8 bg-surface-container-low border border-white/5 rounded-2xl">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-500 border-b border-white/5">
                    <th class="px-5 py-3 font-medium">Property</th>
                    <th class="px-5 py-3 font-medium">Location</th>
                    <th class="px-5 py-3 font-medium">Publish Status</th>
                    <th class="px-5 py-3 font-medium">Listing Status</th>
                    <th class="px-5 py-3 font-medium text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-white/5 last:border-0 hover:bg-surface-container-high transition-colors">
                        <td class="px-5 py-3 text-white font-medium">@item.PropType</td>
                        <td class="px-5 py-3 text-gray-400">@item.Location</td>
                        <td class="px-5 py-3">
                            <span class="text-xs font-semibold @(item.PublishStatus == "Published" ? "text-green-400" : "text-amber-400")">
                                @(string.IsNullOrEmpty(item.PublishStatus) ? "—" : item.PublishStatus)
                            </span>
                        </td>
                        <td class="px-5 py-3 text-gray-300">@(string.IsNullOrEmpty(item.ListingStatus) ? "—" : item.ListingStatus)</td>
                        <td class="px-5 py-3">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-action="Details" asp-route-id="@item.PropId"
                                   class="text-sm font-medium text-white hover:text-gray-300 px-3 py-1.5 rounded-lg hover:bg-surface-container-high transition-all">View</a>
                                <a asp-action="Edit" asp-route-id="@item.PropId"
                                   class="text-sm font-medium text-gray-400 hover:text-white px-3 py-1.5 rounded-lg hover:bg-surface-container-high transition-all">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.PropId"
                                   class="text-sm font-medium text-red-400 hover:text-red-300 px-3 py-1.5 rounded-lg hover:bg-red-500/10 transition-all">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Card grid (reuses the shared property card) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <partial name="_PropertyCard" model="item" />
        }
    </div>
}
else
{
    <div class="text-center py-20 bg-surface-container-low rounded-2xl border border-white/5">
        <span class="material-symbols-outlined text-5xl text-gray-600 mb-3">domain_disabled</span>
        <p class="text-gray-400 mb-4">You haven't listed any properties yet.</p>
        <a asp-action="Create"
           class="inline-flex items-center gap-2 bg-white text-black px-5 py-2.5 rounded-xl font-semibold hover:bg-gray-200 transition-colors text-sm">
            <span class="material-symbols-outlined text-base">add</span>
            New Property
        </a>
    </div>
}
