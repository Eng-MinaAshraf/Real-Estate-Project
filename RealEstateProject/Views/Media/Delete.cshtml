@model RealEstateProject.Models.Media

@{
    ViewData["Title"] = "Delete Media";
}

<div class="aqx-page-header">
    <div>
        <h1>Delete Media</h1>
        <p class="aqx-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="aqx-detail-card">
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/25 text-red-300 text-sm">
        Are you sure you want to delete this media?
    </div>

    <dl class="row">
        <dt>@Html.DisplayNameFor(model => model.Property)</dt>
        <dd>@Html.DisplayFor(model => model.Property.PropId)</dd>
        <dt>@Html.DisplayNameFor(model => model.MediaType)</dt>
        <dd>@Html.DisplayFor(model => model.MediaType)</dd>
        <dt>@Html.DisplayNameFor(model => model.MediaUrl)</dt>
        <dd>@Html.DisplayFor(model => model.MediaUrl)</dd>
    </dl>

    <form asp-action="Delete" class="aqx-actions-bar">
        <input type="hidden" asp-for="MediaId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
