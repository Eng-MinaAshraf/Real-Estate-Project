@model RealEstateProject.Models.Media

@{
    ViewData["Title"] = "Edit Media";
}

<div class="aqx-page-header">
    <div>
        <h1>Edit Media</h1>
        <p class="aqx-subtitle">Media #@Model.MediaId</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="MediaId" />

        <div class="form-group mb-4">
            <label asp-for="PropId" class="control-label block"></label>
            <select asp-for="PropId" class="form-control w-full" asp-items="ViewBag.PropId"></select>
            <span asp-validation-for="PropId" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="MediaType" class="control-label block"></label>
            <input asp-for="MediaType" class="form-control w-full" />
            <span asp-validation-for="MediaType" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="MediaUrl" class="control-label block"></label>
            <input asp-for="MediaUrl" class="form-control w-full" />
            <span asp-validation-for="MediaUrl" class="text-danger"></span>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
