@model IEnumerable<RealEstateProject.Models.Tenant>

@{
    ViewData["Title"] = "Tenants";
}

<div class="aqx-page-header">
    <div>
        <h1>Tenants</h1>
        <p class="aqx-subtitle">@Model.Count() tenant(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <span class="material-symbols-outlined text-base">add</span> New Tenant
    </a>
</div>

@if (Model.Any())
{
    <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="table w-full">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.SmokingStatus)</th>
                    <th>@Html.DisplayNameFor(model => model.Personality)</th>
                    <th>@Html.DisplayNameFor(model => model.Occupation)</th>
                    <th>@Html.DisplayNameFor(model => model.User)</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.SmokingStatus)</td>
                        <td>@Html.DisplayFor(modelItem => item.Personality)</td>
                        <td>@Html.DisplayFor(modelItem => item.Occupation)</td>
                        <td>@Html.DisplayFor(modelItem => item.User.UserId)</td>
                        <td>
                            <div class="aqx-actions justify-end">
                                <a asp-action="Details" asp-route-id="@item.TenantId" class="aqx-btn-ghost">View</a>
                                <a asp-action="Edit" asp-route-id="@item.TenantId" class="aqx-btn-ghost">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.TenantId" class="aqx-btn-ghost aqx-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="aqx-empty">
        <p>No tenants found.</p>
        <a asp-action="Create" class="btn btn-primary">New Tenant</a>
    </div>
}
