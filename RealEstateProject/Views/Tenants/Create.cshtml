@model RealEstateProject.Models.Tenant

@{
    ViewData["Title"] = "New Tenant";
}

<div class="aqx-page-header">
    <div>
        <h1>New Tenant</h1>
        <p class="aqx-subtitle">Add a tenant profile</p>
    </div>
</div>

<div class="aqx-detail-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

        <div class="form-group mb-4">
            <label asp-for="TenantId" class="control-label block"></label>
            <select asp-for="TenantId" class="form-control w-full" asp-items="ViewBag.TenantId"></select>
        </div>
        <div class="form-group mb-4">
            <label asp-for="SmokingStatus" class="control-label block"></label>
            <input asp-for="SmokingStatus" class="form-control w-full" />
            <span asp-validation-for="SmokingStatus" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="Personality" class="control-label block"></label>
            <input asp-for="Personality" class="form-control w-full" />
            <span asp-validation-for="Personality" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="Occupation" class="control-label block"></label>
            <input asp-for="Occupation" class="form-control w-full" />
            <span asp-validation-for="Occupation" class="text-danger"></span>
        </div>

        <div class="aqx-actions-bar">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
